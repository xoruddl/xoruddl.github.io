---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
  empty?: string;
}
const { posts, empty = '표시할 글이 없습니다.' } = Astro.props;
---

{posts.length > 0 ? (
  <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
) : <p class="empty-state">{empty}</p>}
