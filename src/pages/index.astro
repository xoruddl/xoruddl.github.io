---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from '../components/Pagination.astro';
import PostList from '../components/PostList.astro';
import PostSearch from '../components/PostSearch.astro';
import { PAGE_SIZE, sortPosts } from '../lib/posts';

const posts = sortPosts(await getCollection('posts'));
const shown = posts.slice(0, PAGE_SIZE);
const pages = Math.ceil(posts.length / PAGE_SIZE);
---

<BaseLayout>
  <div class="content-shell">
    <PostSearch>
      <div class="section-title"><h2>최근 글</h2><span>{posts.length}개의 기록</span></div>
      <PostList posts={shown} />
      <Pagination current={1} total={pages} />
    </PostSearch>
  </div>
</BaseLayout>
