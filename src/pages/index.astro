---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { asList, excerpt, formatDate, postUrl, readingMinutes, sortPosts, taxonomySlug } from '../lib/posts';

const PAGE_SIZE = 10;
const posts = sortPosts(await getCollection('posts'));
const shown = posts.slice(0, PAGE_SIZE);
const pages = Math.ceil(posts.length / PAGE_SIZE);
const searchItems = posts.map((post) => ({
  title: post.data.title,
  url: postUrl(post),
  date: formatDate(post.data.date),
  minutes: readingMinutes(post),
  categories: asList(post.data.categories).map((name) => ({ name, url: `/categories/${taxonomySlug(name)}/` })),
  tags: asList(post.data.tags),
  excerpt: excerpt(post),
}));
const searchJson = JSON.stringify(searchItems).replace(/</g, '\\u003c');
---

<BaseLayout>
  <div class="content-shell">
    <div class="home-search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
      <label for="home-search-input" class="sr-only">블로그 글 검색</label>
      <input class="search-box" id="home-search-input" type="search" placeholder="제목, 카테고리, 태그로 검색" autocomplete="off" />
    </div>
    <p class="search-status home-search-status" id="home-search-status" hidden></p>
    <div class="post-list" id="home-search-results" hidden></div>
    <div id="home-default-content">
      <div class="section-title"><h2>최근 글</h2><span>{posts.length}개의 기록</span></div>
      <PostList posts={shown} />
      {pages > 1 && <nav class="pagination" aria-label="페이지 이동"><span aria-current="page">1</span><a href="/page2/" aria-label="다음 페이지">다음</a></nav>}
    </div>
    <script is:inline type="application/json" id="home-search-data" set:html={searchJson}></script>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>('#home-search-input');
    const status = document.querySelector<HTMLElement>('#home-search-status');
    const results = document.querySelector<HTMLElement>('#home-search-results');
    const defaultContent = document.querySelector<HTMLElement>('#home-default-content');
    const dataNode = document.querySelector<HTMLScriptElement>('#home-search-data');
    const items = JSON.parse(dataNode?.textContent ?? '[]');
    const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char] ?? char);

    input?.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase('ko');
      const isSearching = query.length > 0;

      if (defaultContent) defaultContent.hidden = isSearching;
      if (status) status.hidden = !isSearching;
      if (results) results.hidden = !isSearching;
      if (!isSearching) {
        if (results) results.innerHTML = '';
        return;
      }

      const found = items
        .filter((item: any) => [item.title, item.excerpt, ...item.categories.map((category: any) => category.name), ...item.tags].join(' ').toLocaleLowerCase('ko').includes(query))
        .slice(0, 30);

      if (status) status.textContent = found.length > 0 ? `${found.length}개의 검색 결과` : '검색 결과가 없습니다.';
      if (results) results.innerHTML = found.map((item: any) => `
        <article class="post-card">
          <div class="post-card-meta"><time>${escapeHtml(item.date)}</time><span>·</span><span>${item.minutes}분</span></div>
          <h2><a href="${encodeURI(item.url)}">${escapeHtml(item.title)}</a></h2>
          <p>${escapeHtml(item.excerpt)}</p>
          ${item.categories.length > 0 ? `<div class="chips">${item.categories.map((category: any) => `<a href="${encodeURI(category.url)}">${escapeHtml(category.name)}</a>`).join('')}</div>` : ''}
        </article>
      `).join('');
    });
  </script>
</BaseLayout>
