---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { asList, sortPosts, taxonomySlug } from '../../lib/posts';

const posts = sortPosts(await getCollection('posts'));
const counts = new Map<string, number>();
for (const post of posts) for (const category of asList(post.data.categories)) counts.set(category, (counts.get(category) ?? 0) + 1);
const categories = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'));

const categoryGroups = new Map([
  ['Spring', ['Kafka', '스프링 핵심 원리 기본편']],
]);
const childCategories = new Set([...categoryGroups.values()].flat());
const compareCategoryNames = (a: string, b: string) => {
  const aStartsWithLatin = /^[A-Za-z]/.test(a);
  const bStartsWithLatin = /^[A-Za-z]/.test(b);
  if (aStartsWithLatin !== bStartsWithLatin) return aStartsWithLatin ? -1 : 1;
  return a.localeCompare(b, aStartsWithLatin ? 'en' : 'ko', { sensitivity: 'base' });
};
const topLevelCategories = categories
  .filter(([name]) => !childCategories.has(name))
  .sort(([a], [b]) => compareCategoryNames(a, b));
---

<BaseLayout title="카테고리">
  <div class="content-shell">
    <header class="page-header"><p class="eyebrow">CATEGORIES</p><h1>카테고리</h1><p>주제별로 기록을 모았습니다.</p></header>
    <div class="category-tree">
      {topLevelCategories.map(([name, count]) => {
        const children = (categoryGroups.get(name) ?? [])
          .map((childName) => [childName, counts.get(childName)] as const)
          .filter((entry): entry is readonly [string, number] => entry[1] !== undefined)
          .sort(([a], [b]) => compareCategoryNames(a, b));
        const hasChildren = children.length > 0;
        const childListId = `category-children-${taxonomySlug(name)}`;

        return (
          <div class:list={['category-group', { 'has-children': hasChildren }] }>
            <div class="category-row">
              <a class="category-link" href={`/categories/${taxonomySlug(name)}/`}>
                <svg class="category-folder" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5A1.5 1.5 0 0 1 5 5h5l2 2h7A1.5 1.5 0 0 1 20.5 8.5v9A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5z" /></svg>
                <span class="category-name">{name}</span>
                <small>{hasChildren ? `${children.length}개 카테고리 · ${count}개 포스트` : `${count}개 포스트`}</small>
                {!hasChildren && <svg class="category-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 7 5 5-5 5" /></svg>}
              </a>
              {hasChildren && (
                <button class="category-toggle" type="button" aria-expanded="true" aria-controls={childListId} data-category-toggle>
                  <span class="sr-only">{name} 하위 카테고리 접기</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9.5 5 5 5-5" /></svg>
                </button>
              )}
            </div>
            {hasChildren && (
              <div class="category-children" id={childListId}>
                {children.map(([childName, childCount]) => (
                  <a class="category-link" href={`/categories/${taxonomySlug(childName)}/`}>
                    <svg class="category-folder" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5A1.5 1.5 0 0 1 5 5h5l2 2h7A1.5 1.5 0 0 1 20.5 8.5v9A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5z" /></svg>
                    <span class="category-name">{childName}</span>
                    <small>{childCount}개 포스트</small>
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-category-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const childList = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!childList) return;

      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      childList.hidden = expanded;
      const label = button.querySelector('.sr-only');
      if (label) label.textContent = `${button.closest('.category-group')?.querySelector('.category-name')?.textContent ?? ''} 하위 카테고리 ${expanded ? '펼치기' : '접기'}`;
    });
  });
</script>
