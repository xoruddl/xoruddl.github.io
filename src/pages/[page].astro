---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from '../components/Pagination.astro';
import PostList from '../components/PostList.astro';
import { PAGE_SIZE, sortPosts } from '../lib/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'));
  const totalPages = Math.ceil(posts.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: `page${page}` },
      props: { posts: posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE), page, totalPages },
    };
  });
}

const { posts, page, totalPages } = Astro.props;
---

<BaseLayout title={`글 목록 ${page}페이지`}>
  <div class="content-shell">
    <header class="page-header"><p class="eyebrow">POSTS</p><h1>모든 기록</h1><p>{page} / {totalPages} 페이지</p></header>
    <PostList posts={posts} />
    <Pagination current={page} total={totalPages} />
  </div>
</BaseLayout>
