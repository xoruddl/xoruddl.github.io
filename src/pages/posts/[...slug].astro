---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import { asList, excerpt, formatShortDate, postSlug, postUrl, readingMinutes, sortPosts, taxonomySlug } from '../../lib/posts';

export async function getStaticPaths() {
  // getStaticPaths는 따로 실행되므로 바깥 frontmatter 상수를 참조할 수 없다.
  const RELATED_SIZE = 5;
  const posts = sortPosts(await getCollection('posts'));
  return posts.map((post, index) => {
    // 같은 (가장 구체적인) 카테고리에서 현재 글과 날짜가 가까운 글을 고른다.
    const category = asList(post.data.categories).at(-1);
    const siblings = category ? posts.filter((other) => asList(other.data.categories).at(-1) === category) : [];
    const position = siblings.indexOf(post);
    const start = Math.max(0, Math.min(position - Math.floor(RELATED_SIZE / 2), siblings.length - RELATED_SIZE - 1));
    const related = siblings.slice(start, start + RELATED_SIZE + 1).filter((other) => other !== post).slice(0, RELATED_SIZE);

    return {
      params: { slug: postSlug(post) },
      props: {
        post,
        category,
        related,
        newer: index > 0 ? posts[index - 1] : null,
        older: index < posts.length - 1 ? posts[index + 1] : null,
      },
    };
  });
}

interface Props {
  post: CollectionEntry<'posts'>;
  category: string | undefined;
  related: CollectionEntry<'posts'>[];
  newer: CollectionEntry<'posts'> | null;
  older: CollectionEntry<'posts'> | null;
}

const { post, category, related, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const categories = asList(post.data.categories);
const tags = asList(post.data.tags);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={post.data.title} description={excerpt(post, 160)} canonical={postUrl(post)} type="article">
  <div class="post-layout">
    <article class="post">
      <header class="post-header">
        {categories.length > 0 && (
          <div class="post-category">
            {categories.map((name, index) => <>{index > 0 && <span aria-hidden="true">›</span>}<a href={`/categories/${taxonomySlug(name)}/`}>{name}</a></>)}
          </div>
        )}
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <span class="post-author">{SITE.author}</span>
          <time datetime={post.data.date.toISOString()}>{formatShortDate(post.data.date)}</time>
          <span>읽는 시간 {readingMinutes(post)}분</span>
          {post.data.last_modified_at && <span>수정 {formatShortDate(post.data.last_modified_at)}</span>}
        </div>
      </header>
      <div class="post-content"><Content /></div>
      <footer class="post-footer">
        {tags.length > 0 && (
          <div class="post-tags">
            <strong>태그</strong>
            <div>{tags.map((tag) => <a href={`/tags/${taxonomySlug(tag)}/`}>{tag}</a>)}</div>
          </div>
        )}
        {category && related.length > 0 && (
          <section class="related-posts">
            <h2>'<a href={`/categories/${taxonomySlug(category)}/`}>{category}</a>' 카테고리의 다른 글</h2>
            <ul>
              {related.map((other) => (
                <li><a href={postUrl(other)}>{other.data.title}</a><time datetime={other.data.date.toISOString()}>{formatShortDate(other.data.date)}</time></li>
              ))}
            </ul>
          </section>
        )}
        <nav class="post-nav" aria-label="이전 및 다음 글">
          {older ? <a href={postUrl(older)}><span>‹ 이전 글</span><strong>{older.data.title}</strong></a> : <span></span>}
          {newer && <a href={postUrl(newer)}><span>다음 글 ›</span><strong>{newer.data.title}</strong></a>}
        </nav>
      </footer>
      {post.data.comments !== false && (
        <section class="comments" aria-label="댓글">
          <script
            is:inline
            src="https://giscus.app/client.js"
            data-repo="xoruddl/xoruddl.github.io"
            data-repo-id="R_kgDOTzWP3g"
            data-category="Announcements"
            data-category-id="DIC_kwDOTzWP3s4DEW1k"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="preferred_color_scheme"
            data-lang="ko"
            crossorigin="anonymous"
            async></script>
        </section>
      )}
    </article>
  </div>
  {toc.length > 0 && (
    <nav class="widget toc" slot="aside" aria-label="목차">
      <h2 class="widget-title">목차</h2>
      <ol>{toc.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
    </nav>
  )}
  <script>
    // 코드 블록마다 전체 내용을 한 번에 복사하는 버튼을 붙인다. pre는 가로 스크롤이 있어 버튼은 바깥 래퍼에 둔다.
    document.querySelectorAll<HTMLPreElement>('.post-content pre').forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.before(wrapper);
      wrapper.append(pre);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = '복사';
      wrapper.append(button);

      let timer: number | undefined;
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code') ?? pre;
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          button.textContent = '복사됨';
        } catch {
          button.textContent = '복사 실패';
        }
        button.classList.add('is-done');
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.textContent = '복사';
          button.classList.remove('is-done');
        }, 1800);
      });
    });
  </script>
</BaseLayout>
